<script>
  (function() {
    class FeaturesCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-features-carousel__track-{{ ai_gen_id }}');
        this.setupCarousel();
      }

      setupCarousel() {
        if (!this.track) return;

        const items = this.track.querySelectorAll('.ai-features-carousel__item-{{ ai_gen_id }}');
        const enabledCount = items.length / 2;

        if (enabledCount <= 4) {
          this.track.style.animation = 'none';
          this.track.style.justifyContent = 'center';
        }
      }
    }

    customElements.define('features-carousel-{{ ai_gen_id }}', FeaturesCarousel{{ ai_gen_id }});
  })();
</script>

