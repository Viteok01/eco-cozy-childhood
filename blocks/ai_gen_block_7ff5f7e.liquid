{% doc %}
  @prompt
    A small section with icons and a brief description of each icon's meaning.
    5-6 icons conveying product quality—eco, 100% natural, etc.
    There should be no more than four icons on the page at a time, and the remaining icons should form a carousel that slowly rotates and rotates horizontally.
    When adapting to the mobile version, all icons and text should be smaller, but the logic should remain the same.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-features-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-features-carousel__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-features-carousel__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-features-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_gap }}px;
    animation: ai-features-scroll-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
  }

  .ai-features-carousel__track-{{ ai_gen_id }}:hover {
    animation-play-state: paused;
  }

  .ai-features-carousel__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - (3 * {{ block.settings.item_gap }}px)) / 4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: {{ block.settings.icon_text_gap }}px;
  }

  .ai-features-carousel__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    flex-shrink: 0;
  }

  .ai-features-carousel__icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    color: {{ block.settings.icon_color }};
  }

  .ai-features-carousel__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
    margin: 0;
  }

  @keyframes ai-features-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-1 * (((100% - (3 * {{ block.settings.item_gap }}px)) / 4) + {{ block.settings.item_gap }}px) * 2));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-features-carousel__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-features-carousel__icon-wrapper-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.7);
      height: calc({{ block.settings.icon_size }}px * 0.7);
    }

    .ai-features-carousel__icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size }}px * 0.7 * 0.6);
      height: calc({{ block.settings.icon_size }}px * 0.7 * 0.6);
    }

    .ai-features-carousel__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_size }}px * 0.85);
    }
  }
{% endstyle %}

<div class="ai-features-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-features-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <features-carousel-{{ ai_gen_id }} class="ai-features-carousel__track-wrapper-{{ ai_gen_id }}">
      <div class="ai-features-carousel__track-{{ ai_gen_id }}">
        {% for i in (1..6) %}
          {% liquid
            assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
            assign feature_text_key = 'feature_' | append: i | append: '_text'
            assign feature_icon_key = 'feature_' | append: i | append: '_icon'

            assign feature_enabled = block.settings[feature_enabled_key]
            assign feature_text = block.settings[feature_text_key]
            assign feature_icon = block.settings[feature_icon_key]
          %}

          {% if feature_enabled %}
            <div class="ai-features-carousel__item-{{ ai_gen_id }}">
              <div class="ai-features-carousel__icon-wrapper-{{ ai_gen_id }}">
                {% case feature_icon %}
                  {% when 'eco' %}
                    <svg class="ai-features-carousel__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2a10 10 0 0 0 10 10 4 4 0 0 1-5 5 2 2 0 0 0-2 2c0 1.5-1.5 2-3 2s-3-.5-3-2a2 2 0 0 0-2-2 4 4 0 0 1-5-5 10 10 0 0 0 10-10Z"/>
                      <path d="M12 2v10"/>
                    </svg>
                  {% when 'natural' %}
                    <svg class="ai-features-carousel__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/>
                      <path d="M12 6v6l4 2"/>
                    </svg>
                  {% when 'organic' %}
                    <svg class="ai-features-carousel__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 20h10"/>
                      <path d="M10 20c5.5-2.5.8-6.4 3-10"/>
                      <path d="M9.5 9.4c1.1.8 1.8 2.2 2.3 3.7-2 .4-3.5.4-4.8-.3-1.2-.6-2.3-1.9-3-4.2 2.8-.5 4.4 0 5.5.8z"/>
                      <path d="M14.1 6a7 7 0 0 0-1.1 4c1.9-.1 3.3-.6 4.3-1.4 1-1 1.6-2.3 1.7-4.6-2.7.1-4 1-4.9 2z"/>
                    </svg>
                  {% when 'recycle' %}
                    <svg class="ai-features-carousel__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/>
                      <path d="M11 19h8.203a1.83 1.83 0 0 0 1.556-.89 1.784 1.784 0 0 0 0-1.775l-1.226-2.12"/>
                      <path d="m14 16-3 3 3 3"/>
                      <path d="M8.293 13.596 7.196 9.5 3.1 10.598"/>
                      <path d="m9.344 5.811 1.093-1.892A1.83 1.83 0 0 1 11.985 3a1.784 1.784 0 0 1 1.546.888l3.943 6.843"/>
                      <path d="m13.378 9.633 4.096 1.098 1.097-4.096"/>
                    </svg>
                  {% when 'safe' %}
                    <svg class="ai-features-carousel__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                      <path d="m9 12 2 2 4-4"/>
                    </svg>
                  {% when 'quality' %}
                    <svg class="ai-features-carousel__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                {% endcase %}
              </div>
              {% if feature_text != blank %}
                <p class="ai-features-carousel__text-{{ ai_gen_id }}">{{ feature_text }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {% for i in (1..6) %}
          {% liquid
            assign feature_enabled_key = 'feature_' | append: i | append: '_enabled'
            assign feature_text_key = 'feature_' | append: i | append: '_text'
            assign feature_icon_key = 'feature_' | append: i | append: '_icon'

            assign feature_enabled = block.settings[feature_enabled_key]
            assign feature_text = block.settings[feature_text_key]
            assign feature_icon = block.settings[feature_icon_key]
          %}

          {% if feature_enabled %}
            <div class="ai-features-carousel__item-{{ ai_gen_id }}">
